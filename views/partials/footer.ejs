<style>
  .site-footer {
    background: var(--bg-color-medium);
    border-top: 1px solid var(--zero-two-fade);
    padding: 28px 40px;
    text-align: center;
    margin-top: auto;
  }

  .site-footer p {
    font-size: 0.82em;
    color: var(--text-muted);
    margin: 0 0 4px;
  }

  .site-footer a {
    color: var(--accent-color);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer a:hover { color: var(--accent-hover-color); }
</style>

<footer class="site-footer">
  <p>&copy; <%= new Date().getFullYear() %> <%= settings.siteName %></p>
  <p>A link service for <a href="https://ucheldrerep.co.uk" target="_blank" rel="noopener">ucheldrerep.co.uk</a></p>
</footer>
