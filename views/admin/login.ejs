<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - <%= settings.siteName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Lato:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --bg-color-darker: #0a0a0f;
      --bg-color-dark: #111118;
      --bg-color-medium: #1a1a24;
      --bg-color-light: #252530;
      --text-color: #e8e6e3;
      --text-muted: #a8a6a3;
      --accent-color: #d4af37;
      --accent-hover-color: #f0c86e;
      --accent-dark-hover: #b8941f;
      --accent-secondary: #8b2f39;
      --zero-two-fade: rgba(255, 255, 255, 0.1);
      --spotlight-color: rgba(212, 175, 55, 0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Lato', sans-serif;
      background: var(--bg-color-dark);
      color: var(--text-color);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
      background-image: radial-gradient(600px 400px at 50% 30%, var(--spotlight-color), rgba(0,0,0,0) 70%);
    }

    .login-card {
      background: var(--bg-color-medium);
      border: 2px solid var(--zero-two-fade);
      border-radius: 16px;
      padding: 50px 40px;
      max-width: 420px;
      width: 95%;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 80px rgba(212, 175, 55, 0.05);
      text-align: center;
    }

    .login-icon {
      width: 80px; height: 80px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bg-color-darker);
      border: 2px solid var(--accent-color);
      color: var(--accent-color);
      font-size: 2rem;
      margin-bottom: 25px;
      box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
    }

    .login-card h2 {
      font-family: 'Libre Baskerville', serif;
      color: var(--accent-color);
      font-size: 1.6em;
      margin-bottom: 8px;
    }

    .login-card .subtitle {
      color: var(--text-muted);
      font-size: 0.9em;
      margin-bottom: 30px;
    }

    .form-group { margin-bottom: 22px; text-align: left; }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-color);
      font-weight: 600;
      font-size: 0.9em;
    }

    .input-row {
      display: flex;
      align-items: center;
    }

    .input-icon {
      width: 48px; height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-color-darker);
      border: 2px solid var(--zero-two-fade);
      border-right: none;
      border-radius: 8px 0 0 8px;
      color: var(--accent-color);
      font-size: 1rem;
    }

    .form-group input {
      flex: 1;
      padding: 13px 16px;
      background: var(--bg-color-darker);
      border: 2px solid var(--zero-two-fade);
      border-radius: 0 8px 8px 0;
      font-size: 14px;
      color: var(--text-color);
      font-family: 'Lato', sans-serif;
      transition: all 0.25s;
    }

    .form-group input::placeholder { color: var(--text-muted); opacity: 0.6; }

    .form-group input:focus {
      outline: none;
      border-color: var(--accent-color);
      box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
    }

    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, var(--accent-color), var(--accent-dark-hover));
      color: var(--bg-color-darker);
      border: none;
      padding: 15px 28px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
      font-family: 'Lato', sans-serif;
      margin-top: 8px;
    }

    .btn-login:hover {
      background: linear-gradient(135deg, var(--accent-hover-color), var(--accent-color));
      box-shadow: 0 8px 28px rgba(212, 175, 55, 0.45);
      transform: translateY(-2px);
    }

    .btn-login:active { transform: translateY(0); }

    .error-msg {
      background: linear-gradient(135deg, #2a1a1c, #3d1f23);
      color: #f5a3ad;
      border: 2px solid var(--accent-secondary);
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 20px;
      font-size: 0.9em;
      text-align: left;
    }

    .back-link {
      display: inline-block;
      margin-top: 20px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85em;
      transition: color 0.2s;
    }

    .back-link:hover { color: var(--accent-color); }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-icon">
      <i class="fa-solid fa-lock"></i>
    </div>
    <h2>Admin Login</h2>
    <p class="subtitle">Enter the admin password to continue</p>

    <% if (error) { %>
    <div class="error-msg">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/admin/login" autocomplete="off">
      <div class="form-group">
        <label><i class="fa-solid fa-key" style="margin-right: 6px;"></i>Password</label>
        <div class="input-row">
          <span class="input-icon"><i class="fa-solid fa-key"></i></span>
          <input type="password" name="password" placeholder="Enter password" required autofocus>
        </div>
      </div>
      <button type="submit" class="btn-login">
        <i class="fa-solid fa-right-to-bracket" style="margin-right: 6px;"></i>Login
      </button>
    </form>

    <a href="/" class="back-link"><i class="fa-solid fa-arrow-left" style="margin-right: 4px;"></i>Back to site</a>
  </div>
</body>
</html>
