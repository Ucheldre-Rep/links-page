<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .page-wrap { display: flex; flex-direction: column; min-height: 100vh; }

    .hero {
      background: var(--bg-color-darker);
      background-image: radial-gradient(800px 350px at 50% 0%, var(--spotlight-color), rgba(0,0,0,0) 70%);
      border-bottom: 1px solid var(--zero-two-fade);
      padding: 52px 24px 44px;
      text-align: center;
    }

    .hero h1 {
      font-family: 'Libre Baskerville', serif;
      font-size: clamp(1.8em, 4vw, 2.8em);
      font-weight: 700;
      color: var(--accent-color);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .hero p {
      font-size: 1.05em;
      color: var(--text-muted);
      max-width: 520px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .links-section {
      flex: 1;
      padding: 44px 24px;
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }

    .links-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 18px;
    }

    .link-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 32px 20px 26px;
      background: linear-gradient(135deg, var(--bg-color-light) 0%, var(--bg-color-medium) 100%);
      border: 2px solid var(--zero-two-fade);
      border-radius: 14px;
      text-decoration: none;
      color: var(--text-color);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      position: relative;
      overflow: hidden;
    }

    .link-tile::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(400px 200px at 50% -10%, rgba(212,175,55,0.08), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .link-tile:hover {
      border-color: var(--accent-color);
      box-shadow: 0 8px 28px rgba(212,175,55,0.18);
      transform: translateY(-4px);
      color: var(--text-color);
    }

    .link-tile:hover::before { opacity: 1; }

    .link-tile-icon {
      width: 58px; height: 58px;
      border-radius: 14px;
      background: var(--bg-color-darker);
      border: 1px solid var(--zero-two-fade);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: var(--accent-color);
      margin-bottom: 16px;
      transition: all 0.25s;
      position: relative;
      z-index: 1;
    }

    .link-tile:hover .link-tile-icon {
      background: rgba(212,175,55,0.1);
      border-color: var(--accent-color);
    }

    .link-tile-title {
      font-weight: 700;
      font-size: 0.97em;
      color: var(--text-color);
      margin-bottom: 6px;
      line-height: 1.35;
      position: relative;
      z-index: 1;
    }

    .link-tile-desc {
      font-size: 0.82em;
      color: var(--text-muted);
      line-height: 1.5;
      position: relative;
      z-index: 1;
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 70px 20px;
      color: var(--text-muted);
    }

    .empty-state i {
      display: block;
      font-size: 3rem;
      opacity: 0.35;
      margin-bottom: 18px;
      color: var(--text-muted);
    }

    .empty-state h3 {
      font-family: 'Libre Baskerville', serif;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .empty-state p { font-size: 0.9em; }
  </style>
</head>
<body>
<div class="page-wrap">
  <%- include('partials/navbar') %>

  <div class="hero">
    <h1><i class="fa-solid fa-link"></i><%= settings.siteName %></h1>
    <p><%= settings.siteDescription %></p>
  </div>

  <section class="links-section">
    <div class="links-grid">
      <% if (links.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-link-slash"></i>
        <h3>No links available yet</h3>
        <p>Check back soon!</p>
      </div>
      <% } else { %>
        <% links.forEach(link => { %>
        <a href="/<%= link.slug %>" class="link-tile">
          <div class="link-tile-icon">
            <i class="<%= link.icon || 'fa-solid fa-link' %>"></i>
          </div>
          <div class="link-tile-title"><%= link.title %></div>
          <% if (link.description) { %>
          <div class="link-tile-desc"><%= link.description %></div>
          <% } %>
        </a>
        <% }) %>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>
</div>
</body>
</html>
