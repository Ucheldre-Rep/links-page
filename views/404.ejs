<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .page-wrap { display: flex; flex-direction: column; min-height: 100vh; }

    .error-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 24px;
    }

    .error-card {
      background: linear-gradient(135deg, var(--bg-color-light) 0%, var(--bg-color-medium) 100%);
      border: 2px solid var(--zero-two-fade);
      border-radius: 18px;
      padding: 52px 44px;
      max-width: 460px;
      width: 100%;
      text-align: center;
      box-shadow: 0 12px 40px rgba(0,0,0,0.35);
      background-image: radial-gradient(600px 300px at 50% 0%, var(--spotlight-color), rgba(0,0,0,0) 70%);
    }

    .error-icon {
      font-size: 3.2rem;
      color: var(--accent-color);
      opacity: 0.5;
      display: block;
      margin-bottom: 20px;
    }

    .error-title {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.7em;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 12px;
    }

    .error-msg {
      font-size: 0.93em;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 32px;
    }

  </style>
</head>
<body>
<div class="page-wrap">
  <%- include('partials/navbar') %>

  <main class="error-main">
    <div class="error-card">
      <i class="fa-solid fa-circle-question error-icon"></i>
      <h1 class="error-title"><%= title %></h1>
      <p class="error-msg">
        <% if (title === 'Page Not Found') { %>
          The link you're looking for doesn't exist or has been removed.
        <% } else { %>
          Something went wrong on our end. Please try again later.
        <% } %>
      </p>
    </div>
  </main>

  <%- include('partials/footer') %>
</div>
</body>
</html>
