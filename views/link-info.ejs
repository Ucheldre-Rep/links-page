<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .page-wrap { display: flex; flex-direction: column; min-height: 100vh; }

    .info-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 24px;
    }

    .info-card {
      background: linear-gradient(135deg, var(--bg-color-light) 0%, var(--bg-color-medium) 100%);
      border: 2px solid var(--zero-two-fade);
      border-radius: 18px;
      padding: 48px 44px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      box-shadow: 0 12px 40px rgba(0,0,0,0.35), 0 0 80px rgba(212,175,55,0.05);
      background-image: radial-gradient(600px 300px at 50% 0%, var(--spotlight-color), rgba(0,0,0,0) 70%);
    }

    .info-icon {
      width: 72px; height: 72px;
      border-radius: 18px;
      background: var(--bg-color-darker);
      border: 2px solid var(--zero-two-fade);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      color: var(--accent-color);
      margin: 0 auto 24px;
    }

    .info-title {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.75em;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 12px;
      line-height: 1.25;
    }

    .info-desc {
      font-size: 0.95em;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 32px;
    }

    .btn-goto {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: linear-gradient(135deg, var(--accent-color), #b8941f);
      color: var(--bg-color-darker);
      border: none;
      padding: 14px 34px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
      box-shadow: 0 4px 18px rgba(212,175,55,0.3);
      font-family: 'Lato', sans-serif;
      letter-spacing: 0.3px;
    }

    .btn-goto:hover {
      background: linear-gradient(135deg, #f0c86e, var(--accent-color));
      box-shadow: 0 6px 26px rgba(212,175,55,0.45);
      transform: translateY(-2px);
      color: var(--bg-color-darker);
    }

  </style>
</head>
<body>
<div class="page-wrap">
  <%- include('partials/navbar') %>

  <main class="info-main">
    <div class="info-card">
      <div class="info-icon">
        <i class="<%= link.icon || 'fa-solid fa-link' %>"></i>
      </div>
      <h1 class="info-title"><%= link.title %></h1>
      <% if (link.description) { %>
      <p class="info-desc"><%= link.description %></p>
      <% } %>
      <p style="font-size: 0.84em; color: var(--text-muted); margin-bottom: 24px; display: flex; align-items: center; justify-content: center; gap: 6px;">
        <i class="fa-solid fa-arrow-up-right-from-square" style="opacity: 0.5;"></i>
        This link will take you to an external page
      </p>
      <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="btn-goto">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Go to Link
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>
</div>
</body>
</html>
